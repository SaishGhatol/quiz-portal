# Copy this file to .env and fill in your values

# MongoDB connection string (get from MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Server port
PORT=3002

# JWT secret — use a long random string in production
JWT_SECRET=your-secret-key-here

# URL where the client is running (for CORS)
CLIENT_URL=http://localhost:5173

# Razorpay — used for plan upgrade payments (test mode keys from the Razorpay dashboard)
# Leave blank in dev to disable payments; the pricing page will still work, checkout will not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
